ction","show_title":false,"collection":"collars-leashes","show_vendor":false,"enable_carousel":true,"grid":4,"rows":1,"show_title_card":false,"show_title_card_image":false,"overlay_style":"shadow","color_scheme":"1"}},"rich_text_Ug6hBG":{"type":"rich-text","blocks":{"button_q4Y8W4":{"type":"button","settings":{"button_label":"Shop Now","button_link":"shopify:\/\/collections\/pet-collection","button_style":"primary"}}},"block_order":["button_q4Y8W4"],"custom_css":["div {padding-top: 5px; padding-right: 0px; padding-bottom: 20px; padding-left: 0px;}"],"settings":{"height":"medium","text_alignment":"center","color_scheme":"none","full_width":false}},"custom_row_jq6rUB":{"type":"custom-row","blocks":{"image_UPcfdp":{"type":"image","settings":{"width":"half","image":"shopify:\/\/shop_images\/pet_campaign_pet_4.png","height":"adapt","height_desktop":400,"height_mobile":300,"subheading":"","title":"","text":"","enlarge_text":false,"button_label":"","image_link":"","text_alignment":"center center","mobile_overlay_under":false,"overlay_style":"shadow","color_scheme":"none","heading_highlight_text":"","heading_highlight_font":true,"heading_highlight_stencil":false,"heading_highlight_color":"rgba(0,0,0,0)","heading_highlight_gradient":""}},"text_MBD88U":{"type":"text","settings":{"width":"half","subheading":"","title":"Pet Charms","title_size":"hl-style","text":"<p>Celebrate your real bond with 26 timeless alphabet charms and four pet-inspired styles, all convertible into keychains for versatile use. Each charm can be laser-engraved, making it a stylish accessory for you and your most loyal companion.<\/p>","button_label":"Shop Now","button_link":"shopify:\/\/products\/pet-charm","button_style":"primary","text_alignment":"center","color_scheme":"none","heading_highlight_text":"","heading_highlight_font":true,"heading_highlight_stencil":false,"heading_highlight_color":"rgba(0,0,0,0)","heading_highlight_gradient":""}}},"block_order":["image_UPcfdp","text_MBD88U"],"custom_css":["div {padding-top: 0px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: #ffffff;}"],"settings":{"alignment":"middle","color_scheme":"none"}},"collapsible_tabs_g4GWwP":{"type":"collapsible-tabs","blocks":{"question_rzUgcG":{"type":"question","settings":{"title":"Can you tell me more about stainless steel pet accessories?","answer":"<p>Stainless steel is pet-safe, non-toxic, highly durable, resistant to corrosion and bacterial growth. Our 316 stainless steel is medical-grade, while 304 stainless steel is food-grade—both reliable for daily use.<\/p>"}},"question_kjXbtR":{"type":"question","settings":{"title":"How do I care for stainless steel pet accessories?","answer":"<p>Clean with a mild, pet-safe detergent. Avoid harsh chemicals, abrasive tools, and steel wool that may scratch the surface. Once clean, dry thoroughly to prevent moisture buildup and keep your piece gleaming.<\/p>"}},"question_HPGPtc":{"type":"question","settings":{"title":"What is Vegatex AppleSkin™ leather?","answer":"<p>AppleSkin™ leather by Vegatex is a soft, durable, and eco-friendly material made from upcycled waste in the beverage industry.<\/p><ul><li>It’s certified 66% bio-based by the USDA<\/li><li>It’s PETA-approved vegan and crulty-free<\/li><li>It’s EU-REACH certified, non-toxic, VOC-free, and safe for pets<\/li><\/ul>"}},"question_NTUnxD":{"type":"question","settings":{"title":"How do I care for Vegatex AppleSkin™ leather pet accessories?","answer":"<p>Gently wipe with a dry microfiber cloth to remove dust. For deeper cleaning, use a slightly damp cloth and mild soap (never soak), then dry immediately. Avoid direct sunlight or high heat, and store in a cool, dry place. For extra care, apply a vegan-safe conditioner monthly to keep it soft and supple.<\/p>"}},"question_CyQJTe":{"type":"question","settings":{"title":"Where are lab-grown diamonds and gemstones?","answer":"<p>Lab-grown diamonds and gemstones are created in a controlled laboratory environment, replicating the natural conditions under which they form in the earth. They have the same chemical, physical, and optical properties as their natural counterparts.<\/p>"}},"question_KPzMNU":{"type":"question","settings":{"title":"Are pet accessories covered by THE FUTURE ROCKS Warranty?","answer":"<p>No, all pet accessories—except for Pawtner & Me necklaces—are not covered by warranty for hygienic reasons. If you have questions, please contact our Customer Service.<\/p>"}},"question_gVrGY9":{"type":"question","settings":{"title":"How can I return my order?","answer":"<p>If your item has a manufacturing defect, you may return the unused product—tags attached—to us within 14 days of purchase for a refund or exchange. For more information, please click our policy <a href=\"https:\/\/thefuturerocks.com\/pages\/refund-policy\"><span style=\"text-decoration:underline\">here<\/span><\/a>.<\/p>"}}},"block_order":["question_rzUgcG","question_kjXbtR","question_HPGPtc","question_NTUnxD","question_CyQJTe","question_KPzMNU","question_gVrGY9"],"name":"Collapsible tabs","settings":{"title":"Frequently Asked Questions"}},"rich_text_W7gWdp":{"type":"rich-text","custom_css":["div {padding-top: 10px; padding-right: 0px; padding-bottom: 10px; padding-left: 0px;}"],"settings":{"height":"medium","text_alignment":"center","color_scheme":"none","full_width":false}}},"order":["main","foxify_1733306160fqi_c4_D4MMCc","image_with_text_overlay_3zzhwh","rich_text_FQpbbp","custom_row_iPKRjk","featured_collection_hDKtPf","rich_text_T4iQJM","custom_row_hLLUh9","featured_collection_7MKCUJ","rich_text_Ug6hBG","custom_row_jq6rUB","collapsible_tabs_g4GWwP","rich_text_W7gWdp"]}