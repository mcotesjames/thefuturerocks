    "collapsible_tabs_g4GWwP": {
      "type": "collapsible-tabs",
      "blocks": {
        "question_rzUgcG": {
          "type": "question",
          "settings": {
            "title": "Can you tell me more about stainless steel pet accessories?",
            "answer": "<p>Stainless steel is pet-safe, non-toxic, highly durable, resistant to corrosion and bacterial growth. Our 316 stainless steel is medical-grade, while 304 stainless steel is food-grade—both reliable for daily use.</p>"
          }
        },
        "question_kjXbtR": {
          "type": "question",
          "settings": {
            "title": "How do I care for stainless steel pet accessories?",
            "answer": "<p>Clean with a mild, pet-safe detergent. Avoid harsh chemicals, abrasive tools, and steel wool that may scratch the surface. Once clean, dry thoroughly to prevent moisture buildup and keep your piece gleaming.</p>"
          }
        },
        "question_HPGPtc": {
          "type": "question",
          "settings": {
            "title": "What is Vegatex AppleSkin™ leather?",
            "answer": "<p>AppleSkin™ leather by Vegatex is a soft, durable, and eco-friendly material made from upcycled waste in the beverage industry.</p><ul><li>It’s certified 66% bio-based by the USDA</li><li>It’s PETA-approved vegan and crulty-free</li><li>It’s EU-REACH certified, non-toxic, VOC-free, and safe for pets</li></ul>"
          }
        },
        "question_NTUnxD": {
          "type": "question",
          "settings": {
            "title": "How do I care for Vegatex AppleSkin™ leather pet accessories?",
            "answer": "<p>Gently wipe with a dry microfiber cloth to remove dust. For deeper cleaning, use a slightly damp cloth and mild soap (never soak), then dry immediately. Avoid direct sunlight or high heat, and store in a cool, dry place. For extra care, apply a vegan-safe conditioner monthly to keep it soft and supple.</p>"
          }
        },
        "question_CyQJTe": {
          "type": "question",
          "settings": {
            "title": "Where are lab-grown diamonds and gemstones?",
            "answer": "<p>Lab-grown diamonds and gemstones are created in a controlled laboratory environment, replicating the natural conditions under which they form in the earth. They have the same chemical, physical, and optical properties as their natural counterparts.</p>"
          }
        },
        "question_KPzMNU": {
          "type": "question",
          "settings": {
            "title": "Are pet accessories covered by THE FUTURE ROCKS Warranty?",
            "answer": "<p>No, all pet accessories—except for Pawtner & Me necklaces—are not covered by warranty for hygienic reasons. If you have questions, please contact our Customer Service.</p>"
          }
        },
        "question_gVrGY9": {
          "type": "question",
          "settings": {
            "title": "How can I return my order?",
            "answer": "<p>If your item has a manufacturing defect, you may return the unused product—tags attached—to us within 14 days of purchase for a refund or exchange. For more information, please click our policy <a href=\"https://thefuturerocks.com/pages/refund-policy\"><span style=\"text-decoration:underline\">here</span></a>.</p>"
          }
        }
      },
