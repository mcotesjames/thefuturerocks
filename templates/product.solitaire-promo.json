>{{ product.metafields.custom.material_durability_care }}</p>\n\n{% endif %}\n{% if product.metafields.custom.material_conscious_practice %}\n\n<p><span class=\"secondary-title\">Conscious practices:&nbsp; </span>{{ product.metafields.custom.material_conscious_practice }}</p>\n\n{% endif %}</p>\n  <p>{% if product.metafields.custom.secondary_metal %}\n\n<p><span class=\"primary-title\">Secondary material:&nbsp; </span>{{ product.metafields.custom.secondary_metal }}</p>\n\n{% endif %}\n{% if product.metafields.custom.secondary_metal_description_breakdown %}\n\n<p><span class=\"secondary-title\">About this material:&nbsp; </span>{{ product.metafields.custom.secondary_metal_description_breakdown }}</p>\n\n{% endif %}\n{% if product.metafields.custom.secondary_metal_durability_care %}\n\n<p><span class=\"secondary-title\">Durability & care:&nbsp; </span>{{ product.metafields.custom.secondary_metal_durability_care }}</p>\n\n{% endif %}\n{% if product.metafields.custom.secondary_metal_conscious_practice %}\n\n<p><span class=\"secondary-title\">Conscious practices:&nbsp; </span>{{ product.metafields.custom.secondary_metal_conscious_practice }}</p>\n\n{% endif %}</p>\n  </div>\n  <div class=\"column\">\n  <p>{% if product.metafields.custom.primary_gemstone %}\n\n<p><span class=\"primary-title\">Primary gemstone:&nbsp; </span>{{ product.metafields.custom.primary_gemstone }}</p>\n\n{% endif %}\n{% if product.metafields.custom.primary_gemstone_total_carat_weight %}\n\n<p><span class=\"secondary-title\">Total carat weight:&nbsp; </span>{{ product.metafields.custom.primary_gemstone_total_carat_weight }}</p>\n\n{% endif %}\n{% if product.metafields.custom.primary_gemstone_center_stone_carat_weight %}\n\n<p><span class=\"secondary-title\">Center stone total weight:&nbsp; </span>{{ product.metafields.custom.primary_gemstone_center_stone_carat_weight }}</p>\n\n{% endif %}\n{% if product.metafields.custom.primary_gemstone_color_grade %}\n\n<p><span class=\"secondary-title\">Color gra