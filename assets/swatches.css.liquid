{% liquid
  # Swatch stylesheet — generated from settings.swatch_value_list.
  # Each line: "<variant value>:<color-or-image>"
  #   #hex                -> solid  (--swatch-background-color)
  #   #hex#hex[#hex]       -> hard-edged linear-gradient (--swatch-background-image)
  #   https://… or //…     -> image URL used directly (--swatch-background-image)
  #   filename.png         -> Shopify Files image via file_img_url
  # Value is taken as everything after the FIRST colon so full URLs
  # (which contain "https://") survive intact.
  if settings.swatch_enabled and settings.swatch_value_list != blank
    assign swatch_lines = settings.swatch_value_list | newline_to_br | strip_newlines | split: '<br />'
    for line in swatch_lines
      assign name_part = line | split: ':' | first
      assign attr_val = name_part | replace: '"', '' | strip | downcase
      assign value = line | remove_first: name_part | remove_first: ':' | strip
      if attr_val == blank or value == blank
        continue
      endif

      if value contains '//'
        echo '[data-swatch="' | append: attr_val | append: '"]:not([data-swatch-native]) { --swatch-background-image: url(' | append: value | append: ') }'
      elsif value contains '#'
        assign color_split = value | split: '#'
        if color_split.size == 2
          echo '[data-swatch="' | append: attr_val | append: '"]:not([data-swatch-native]) { --swatch-background-color:' | append: value | append: '}'
        else
          assign bg_img = 'linear-gradient(to right, #' | append: color_split[1] | append: ', '
          if color_split.size == 3
            assign bg_img = bg_img | append: '#' | append: color_split[1] | append: ' 50%, #' | append: color_split[2] | append: ' 50%, '
          elsif color_split.size >= 4
            assign bg_img = bg_img | append: '#' | append: color_split[1] | append: ' 33.3%, #' | append: color_split[2] | append: ' 33.3%, '
            assign bg_img = bg_img | append: '#' | append: color_split[2] | append: ' 66.6%, #' | append: color_split[3] | append: ' 66.6%, '
          endif
          assign bg_img = bg_img | append: '#' | append: color_split.last | append: ')'
          echo '[data-swatch="' | append: attr_val | append: '"]:not([data-swatch-native]) { --swatch-background-image: ' | append: bg_img | append: ' }'
        endif
      else
        assign url = value | file_img_url: '128x128', crop: settings.swatch_crop_align
        echo '[data-swatch="' | append: attr_val | append: '"]:not([data-swatch-native]) { --swatch-background-image: url(' | append: url | append: ') }'
      endif
    endfor
  endif
%}
