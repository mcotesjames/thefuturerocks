  {{ 'redesign.css' | asset_url | stylesheet_tag: preload: true }}

  {%- comment -%} Redesign: theme settings exposed as CSS variables, consumed by redesign.css {%- endcomment -%}
  <style>
    :root {
      --btn-bg: {{ settings.btn_col }};
      --btn-bg-hover: {{ settings.btn_col_alt }};
      --btn-text: {{ settings.btn_col_txt }};
      --btn-secondary-bg: {{ settings.btn_alt_bg }};
      --btn-secondary-text: {{ settings.btn_alt_txt }};
      --btn-radius: {{ settings.button_border_radius }}px;
      --btn-text-size: {{ settings.btn_text_size | default: 18 }}px;
      --site-gutter: {{ settings.site_gutter }}px;
    }
    .card-scheme--1 { --card-text: {{ settings.card_1_text }}; --card-text-secondary: {{ settings.card_1_text_secondary }}; }
    .card-scheme--2 { --card-text: {{ settings.card_2_text }}; --card-text-secondary: {{ settings.card_2_text_secondary }}; }
    .card-scheme--3 { --card-text: {{ settings.card_3_text }}; --card-text-secondary: {{ settings.card_3_text_secondary }}; }
    {%- comment -%}
      Card scheme vars re-wired to settings. The flattened styles.css
      baked these in as constants (old brand colours), disconnecting the
      Customizer. Formulas ported verbatim from the deleted
      styles.css.liquid (commit f917d23): --bg prefers the gradient,
      --text is an RGB triplet (consumed as rgb(var(--text))), headings
      take the raw text colour, --btn-bg is text mixed 8% into bg.
      Loaded after styles.css, so these win by order.
    {%- endcomment -%}
    {%- liquid
      assign card_1_bg = settings.card_1_bg
      assign card_1_head = settings.card_1_text
      if settings.text_lighter_than_heading
        assign card_1_text = settings.card_1_text | color_mix: card_1_bg, 80
      else
        assign card_1_text = settings.card_1_text
      endif
      assign card_2_bg = settings.card_2_bg
      assign card_2_head = settings.card_2_text
      if settings.text_lighter_than_heading
        assign card_2_text = settings.card_2_text | color_mix: card_2_bg, 80
      else
        assign card_2_text = settings.card_2_text
      endif
      assign card_3_bg = settings.card_3_bg
      assign card_3_head = settings.card_3_text
      if settings.text_lighter_than_heading
        assign card_3_text = settings.card_3_text | color_mix: card_3_bg, 80
      else
        assign card_3_text = settings.card_3_text
      endif
    -%}
    .card-scheme--1,
    .card-scheme-vars--1 {
      --bg: {{ settings.card_1_bg_grad | default: card_1_bg }};
      --text: {{ card_1_text | color_extract: "red" }}, {{ card_1_text | color_extract: "green" }}, {{ card_1_text | color_extract: "blue" }};
      --headings: {{ card_1_head }};
      --btn-bg: {{ card_1_text | color_mix: card_1_bg, 8 }};
    }
    .card-scheme--2,
    .card-scheme-vars--2 {
      --bg: {{ settings.card_2_bg_grad | default: card_2_bg }};
      --text: {{ card_2_text | color_extract: "red" }}, {{ card_2_text | color_extract: "green" }}, {{ card_2_text | color_extract: "blue" }};
      --headings: {{ card_2_head }};
      --btn-bg: {{ card_2_text | color_mix: card_2_bg, 8 }};
    }
    .card-scheme--3,
    .card-scheme-vars--3 {
      --bg: {{ settings.card_3_bg_grad | default: card_3_bg }};
      --text: {{ card_3_text | color_extract: "red" }}, {{ card_3_text | color_extract: "green" }}, {{ card_3_text | color_extract: "blue" }};
      --headings: {{ card_3_head }};
      --btn-bg: {{ card_3_text | color_mix: card_3_bg, 8 }};
    }
  </style>

  {%- if settings.swatch_enabled and settings.swatch_value_list != blank -%}
