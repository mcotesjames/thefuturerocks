{%- liquid
  if section.settings.enable_carousel
    assign product_limit = 20
  elsif section.settings.show_title_card
    assign product_limit = section.settings.grid | times: section.settings.rows | minus: 1
  else
    assign product_limit = section.settings.grid | times: section.settings.rows
  endif
  assign collection = collections[section.settings.collection]
-%}

<div class="section-id-{{ section.id }} collection-slider-row module-inline--{{ section.settings.inline_padding | default: 'inset' }}" data-section-type="featured-collection">
  {%- liquid
    comment
      With the title card on, "View all" ALWAYS sits inside the card;
      the position setting only applies when the card is off.
    endcomment
    assign show_view_all_in_header = false
    assign show_view_all_below = false
    assign show_view_all_in_card = false
    if section.settings.collection != blank
      if section.settings.show_title_card
        assign show_view_all_in_card = true
      elsif section.settings.view_all_position == 'below'
        assign show_view_all_below = true
      else
        assign show_view_all_in_header = true
      endif
    endif
    assign view_all_label = section.settings.view_all_label
    if view_all_label == blank
      assign view_all_label = 'sections.featured_collection.view_all' | t
    endif
  -%}
  {%- liquid
    comment
      Render the title row only when something in it is VISIBLE — a
      hidden title (show_title off) with no header CTA used to leave
      an empty row carrying its stray bottom margin.
    endcomment
    assign show_title_row = show_view_all_in_header
    if section.settings.title != blank and section.settings.show_title
      assign show_title_row = true
    endif
  -%}
  {%- if show_title_row -%}
    <div class="section-header">
      {% if section.settings.title != blank %}
        <h2 class="section-title{% unless section.settings.show_title %} visually-hidden{% endunless %}"><a href="{{ collection.url }}">{{ section.settings.title | escape }}</a></h2>
      {% endif %}
      {%- if show_view_all_in_header -%}
        <a class="section-header__view-all btn btn--secondary btn--link" href="{{ collection.url }}"><span class="btn__text">{{ view_all_label | escape }}</span></a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <cc-carousel class="cc-carousel cc-carousel--off-edge-mobile{% unless section.settings.enable_carousel %} cc-carousel--mobile-only{% endunless %} card-margin" allow-mouse-drag rebuild-on-resize data-cc-animate="cc-fade-in-up">
    <div class="cc-carousel-buttons cc-carousel-buttons--overlay-top">
      <button class="cc-carousel-button cc-carousel-button--prev tap-target" aria-label="{{ 'general.accessibility_labels.previous' | t }}"><span class="icon--small ltr-icon">{% render 'svg-chevron-left' %}</span></button>
      <button class="cc-carousel-button cc-carousel-button--next tap-target" aria-label="{{ 'general.accessibility_labels.next' | t }}"><span class="icon--small ltr-icon">{% render 'svg-chevron-right' %}</span></button>
    </div>
    <div class="cc-carousel__scroll-outer">
      <div class="product-list product-list--per-row-{{ section.settings.grid }} product-list--per-row-mob-{{ settings.prod_thumb_mob_per_row }} product-list--image-shape-{{ settings.prod_thumb_shape }} cc-carousel__scroll-area">
        {% if section.settings.collection == blank %}

          {% for i in (1..product_limit) %}
            {% render 'onboarding-product-block', forloop: forloop %}
          {% endfor %}

        {% else %}

          {%- if section.settings.show_title_card -%}
            {%- capture title_card_html -%}
            <div class="product-block product-block--mobile-wide">
              {%- liquid
                if section.settings.show_title_card_image
                  if section.settings.title_card_image != blank
                    assign title_card_image = section.settings.title_card_image
                  elsif collection.image
                    assign title_card_image = collection.image
                  endif
                endif
              -%}
              {%- comment -%}
                featured-collection__title-card: dedicated styling hook —
                this card shares all its other classes with the product-list
                / main-collection title cards, so style THIS class (or
                restructure inside it) to stay scoped to featured collection.
              {%- endcomment -%}
              <div class="featured-collection__title-card product-list-heading-block scale-on-hover card-scheme card-scheme--{{ section.settings.color_scheme }} card-br-oh height--cover page-header page-header--with-background {% if title_card_image %}image-overlay image-overlay--bg-{{ section.settings.overlay_style }}{% endif %}">
                {%- if title_card_image != blank -%}
                  {%- render 'background-image', image: title_card_image, extra_classes: 'scale-on-hover__target' -%}
                {%- endif -%}

                {%- comment -%}
                  The .product-list-heading-block__text wrapper is removed
                  in this card (all devices) — the card itself carries the
                  site-gutter padding (redesign.css title-card rules).
                {%- endcomment -%}
                <div class="overlay-text overlay-text--inline overlay--v-top align-start image-overlay__over" data-cc-animate data-cc-animate-delay="0.2s">
                  <div class="overlay-text__inner">
                    <div class="overlay-text__text">
                      <h2 class="overlay-text__title heading-3" id="{{ section.id }}-Heading">{{ collection.title | link_to: collection.url }}</h2>
                      {%- if collection.description != blank -%}
                      <div class="overlay-text__rte rte cf reading-width">{{ collection.description }}</div>
                      {%- endif -%}
                      {%- if show_view_all_in_card -%}
                        <a class="section-header__view-all btn btn--secondary btn--link" href="{{ collection.url }}"><span class="btn__text">{{ view_all_label | escape }}</span></a>
                      {%- endif -%}
                    </div>
                  </div>
                </div>

                <a class="product-list-heading-block__link" href="{{ collection.url }}" aria-labelledby="{{ section.id }}-Heading"></a>
              </div>
            </div>
            {%- endcapture -%}
            {%- unless section.settings.title_card_position == 'last' -%}
              {{ title_card_html }}
            {%- endunless -%}
          {%- endif -%}

          {%- liquid
            if settings.prod_thumb_shape == 'portrait-23'
              assign chosen_aspect_ratio = 0.67
            elsif settings.prod_thumb_shape == 'portrait-45'
              assign chosen_aspect_ratio = 0.8
            elsif settings.prod_thumb_shape == 'square'
              assign chosen_aspect_ratio = 1.0
            elsif settings.prod_thumb_shape == 'landscape-54'
              assign chosen_aspect_ratio = 1.25
            elsif settings.prod_thumb_shape == 'landscape-32'
              assign chosen_aspect_ratio = 1.50
            elsif settings.prod_thumb_shape == 'tallest'
              assign chosen_aspect_ratio = 99
              for product in collection.products limit: product_limit
                if product.featured_media.preview_image.aspect_ratio < chosen_aspect_ratio
                  assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                endif
              endfor
            else
              assign chosen_aspect_ratio = 0
              for product in collection.products limit: product_limit
                if product.featured_media.preview_image.aspect_ratio > chosen_aspect_ratio
                  assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                endif
              endfor
            endif
          -%}
          {% for product in collection.products limit: product_limit %}
            {% render 'product-block', product: product, collection: collection, custom_aspect_ratio: chosen_aspect_ratio, no_swiping: true %}
          {% endfor %}

          {%- if section.settings.show_title_card and section.settings.title_card_position == 'last' -%}
            {{ title_card_html }}
          {%- endif -%}

        {% endif %}
      </div>
    </div>
  </cc-carousel>

  {%- if show_view_all_below -%}
    <div class="section-footer">
      <a class="section-header__view-all btn btn--secondary btn--link" href="{{ collection.url }}"><span class="btn__text">{{ view_all_label | escape }}</span></a>
    </div>
  {%- endif -%}
</div>


{% schema %}
  {
    "name": "Featured collection",
    "class": "section-featured-collection",
    "disabled_on": {
      "groups": [
        "aside"
      ]
    },
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Featured collection"
      },
      {
        "type": "checkbox",
        "id": "show_title",
        "label": "Show heading",
        "info": "A hidden heading will still be readable by search engines and screen readers",
        "default": false
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "select",
        "id": "inline_padding",
        "label": "Inline padding",
        "info": "Wide uses the site gutter; Inset uses the 5% module grid.",
        "default": "inset",
        "options": [
          {
            "value": "wide",
            "label": "Wide"
          },
          {
            "value": "inset",
            "label": "Inset"
          }
        ]
      },
      {
        "type": "select",
        "id": "view_all_position",
        "label": "'View all' position",
        "info": "Applies when the title card is off. With the title card on, 'View all' always sits inside the card.",
        "default": "header",
        "options": [
          {
            "value": "header",
            "label": "Title row"
          },
          {
            "value": "below",
            "label": "Below products"
          }
        ]
      },
      {
        "type": "text",
        "id": "view_all_label",
        "label": "'View all' label",
        "info": "Leave blank for the default. The trailing + is added automatically."
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show product vendor",
        "default": false
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "checkbox",
        "id": "enable_carousel",
        "label": "Enable carousel on desktop",
        "info": "Always a carousel on mobile",
        "default": true
      },
      {
        "type": "range",
        "id": "grid",
        "label": "Number of columns on desktop",
        "min": 2,
        "max": 5,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "rows",
        "label": "Rows",
        "info": "Does not apply to carousel layout",
        "min": 1,
        "max": 5,
        "step": 1,
        "default": 1
      },
      {
        "type": "header",
        "content": "Title card"
      },
      {
        "type": "checkbox",
        "id": "show_title_card",
        "label": "Show title card",
        "default": true
      },
      {
        "type": "select",
        "id": "title_card_position",
        "label": "Title card position",
        "default": "first",
        "options": [
          {
            "value": "first",
            "label": "First item"
          },
          {
            "value": "last",
            "label": "Last item"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_title_card_image",
        "label": "Show background image",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "title_card_image",
        "label": "Custom image"
      },
      {
        "id": "overlay_style",
        "type": "select",
        "label": "Overlay style",
        "default": "shadow",
        "options": [
          {
            "value": "full",
            "label": "Tint"
          },
          {
            "value": "shadow",
            "label": "Text shadow"
          },
          {
            "value": "full image-overlay--bg-shadow",
            "label": "Text shadow and tint"
          },
          {
            "value": "no_background",
            "label": "No background"
          }
        ]
      },
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Color scheme",
        "info": "Used when there is no image",
        "default": "1",
        "options": [
          {
            "value": "1",
            "label": "Card 1"
          },
          {
            "value": "2",
            "label": "Card 2"
          },
          {
            "value": "3",
            "label": "Card 3"
          },
          {
            "value": "none",
            "label": "No card"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Featured collection",
        "settings": {
          "title": "Featured collection"
        }
      }
    ]
  }
{% endschema %}
