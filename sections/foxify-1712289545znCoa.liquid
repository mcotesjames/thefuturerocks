}

.glow {
  font-size: 14px;
  color: #fff;
  text-align: right;
  -webkit-animation: glow .01s ease-in-out infinite alternate;
  -moz-animation: glow .01s ease-in-out infinite alternate;
  animation: glow .01s ease-in-out infinite alternate;
}

