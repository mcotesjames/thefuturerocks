<style>svg{
  color: black;
}

.f\:maps__box .gm-style iframe+div
{
  border: none!important;
}


a {text-decoration: none !important}

/*mover start*/
@keyframes move-up-down {
  0% { transform: translateY(8px); }
  100% { transform: translateY(-8px); }
}
@keyframes move-up-down-reverse {
  0% { transform: translateY(-8px); }
  100% { transform: translateY(8px); }
}
@keyframes move-up-down-middle {
  0% { transform: translate(-50%, 8px); }
  100% { transform: translate(-50%, -8px); }
}
@keyframes move-left-right {
  0% { transform: translateX(8px); }
  100% { transform: translateX(-8px); }
}

.mover-2 {
  animation: move-up-down 2s linear infinite alternate;
}
.mover-3 {
  animation: move-up-down 3s linear infinite alternate;
}
.mover-3-middle {
  animation: move-up-down-middle 3s linear infinite alternate;
}
.mover-reverse-2 {
  animation: move-up-down-reverse 2s linear infinite alternate;
}
.mover-reverse-3 {
  animation: move-up-down-reverse 3s linear infinite alternate;
}
.mover-4{
  animation: move-left-right 2s linear infinite alternate;
}
/*mover ends*/

/*pulse start*/
@keyframes pulse {
  0% {
    opacity: 0;
    transform: translate(-50%,-50%) scale(1);
  }
  40% {
    opacity: 1;
    transform: translate(-50%,-50%) scale(1.18);
  }
  80% {
    opacity: 1;
    transform: translate(-50%,-50%) scale(1.32);
    border-color: rgba(246,240,249, 0.5);
  }
  100% {
    opacity: 0;
    transform: translate(-50%,-50%) scale(1.4);
    border-color: transparent;
  }
}
.f-pulse-animation-el {
  position: relative;
}
.f-pulse-animation-el:before,
.f-pulse-animation-el:after {
  content: '';
  width: 100%;
  height: 100%;
  border: 3px solid rgba(27,43,39, 1);
  border-radius: 50%;
  display: block;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  background: transparent;
  z-index: 1;
}
.f-pulse-animation-el:before {
  animation: pulse 1.5s linear infinite;
}
.f-pulse-animation-el:after {
  animation: pulse 1.5s .75s linear infinite;
}
/*pulse ends*/

