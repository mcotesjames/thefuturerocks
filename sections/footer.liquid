{%- comment -%}
  Footer — 2026 redesign (rebuilt markup; old section-footer__* inner
  classes retired — nothing outside styles.css referenced them).
  Styling lives in assets/redesign.css (section 12).

  Data sources:
  - Newsletter: Klaviyo embed — all content renders from Klaviyo via
    the form ID setting (plus @app blocks as an escape hatch).
  - Menu columns: Admin nav menus via menu blocks.
  - Social icons: theme settings via snippets/social-icons.
  - Legal links: the "Lower footer menu" linklist.
  - Butterfly Mark, logo, copyright: section settings.
  - Country/language selectors: mobile only, per design (desktop
    omission flagged with the designer).
{%- endcomment -%}

<div class="footer-rd" data-section-type="footer" style="--footer-bg: {{ section.settings.bg_color }}; --footer-text: {{ section.settings.text_color }};">
  <div class="footer-rd__top">
    <div class="footer-rd__newsletter">
      {%- if section.settings.klaviyo_form_id != blank -%}
        <div class="klaviyo-form-{{ section.settings.klaviyo_form_id }}"></div>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer-rd__menus">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="footer-rd__menu" role="navigation" aria-label="{{ 'layout.footer.navigation_aria_label' | t | escape }}" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h2 class="footer-rd__menu-title heading-3">{{ block.settings.title | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer-rd__menu-list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer-rd__mid">
    <div class="footer-rd__social">
      {% render 'social-icons', icon_setting: settings.social_custom_icon_footer, icon_size: 'x30' %}
    </div>

    {%- if section.settings.butterfly_image != blank or section.settings.butterfly_text != blank -%}
      <div class="footer-rd__butterfly">
        {%- if section.settings.butterfly_image != blank -%}
          <div class="footer-rd__butterfly-badge">
            {{ section.settings.butterfly_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: section.settings.butterfly_image.alt | default: 'Butterfly Mark — certified' }}
          </div>
        {%- endif -%}
        {%- if section.settings.butterfly_text != blank -%}
          <div class="footer-rd__butterfly-text caption">{{ section.settings.butterfly_text | escape | newline_to_br }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="footer-rd__bottom">
    <div class="footer-rd__legal">
      <span class="footer-rd__copyright">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | escape }}</span>
      {%- if section.settings.lower_menu != blank -%}
        <ul class="footer-rd__legal-menu" role="navigation" aria-label="{{ 'layout.footer.navigation_aria_label' | t | escape }}">
          {%- for link in linklists[section.settings.lower_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.logo != blank -%}
      <div class="footer-rd__logo">
        {{ section.settings.logo | image_url: width: 2000 | image_tag: loading: 'lazy', alt: shop.name }}
      </div>
    {%- endif -%}
  </div>

  {%- assign showing_localization = false -%}
  {%- if section.settings.show_language_selector and localization.available_languages.size > 1 -%}{%- assign showing_localization = true -%}{%- endif -%}
  {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}{%- assign showing_localization = true -%}{%- endif -%}
  {%- if showing_localization -%}
    <div class="footer-rd__localization js-only">
      {% render 'localization', input_prefix: 'footer', rd_arrow: true %}
    </div>
  {%- endif -%}
</div>

<!-- Start of SleekFlow Embed Code -->
  <script src="https://chat.sleekflow.io/embed_iframe.js"
    data-id="travischatwidget"
    data-companyid="f08f2937-bffd-45f5-a45d-a278919ab6bc"
    data-location="eastasia"
    type="text/javascript">
  </script>
<!-- End of SleekFlow Embed Code -->

{% schema %}
  {
    "name": "Footer",
    "class": "section-footer",
    "max_blocks": 6,
    "settings": [
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background",
        "default": "#F8F8EC"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "default": "#000000"
      },
      {
        "type": "header",
        "content": "Newsletter",
        "info": "The signup form renders entirely from Klaviyo."
      },
      {
        "type": "text",
        "id": "klaviyo_form_id",
        "label": "Klaviyo form ID",
        "info": "e.g. TbkEcx — from the Klaviyo form embed code (klaviyo-form-XXXXXX)"
      },
      {
        "type": "header",
        "content": "Butterfly Mark"
      },
      {
        "type": "image_picker",
        "id": "butterfly_image",
        "label": "Badge image"
      },
      {
        "type": "textarea",
        "id": "butterfly_text",
        "label": "Text",
        "info": "Hidden on mobile, per design",
        "default": "Independent verification of the highest sustainability standards."
      },
      {
        "type": "header",
        "content": "Lower footer"
      },
      {
        "type": "link_list",
        "id": "lower_menu",
        "label": "Legal menu"
      },
      {
        "type": "text",
        "id": "copyright",
        "label": "Copyright text",
        "info": "Rendered after \"© <current year>\"",
        "default": "The Future Rocks Company Limited. DPMS Category A Registrant (Registration No. A-B-23-12-00016)"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Large wordmark, bottom right. Hidden on mobile, per design."
      },
      {
        "type": "header",
        "content": "Country/Region and language selectors",
        "info": "Shown on mobile only, per design. To add a country/region or language, go to your store settings."
      },
      {
        "type": "checkbox",
        "id": "show_country_selector",
        "label": "Enable country/region selector",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_language_selector",
        "label": "Enable language selector",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "menu",
        "name": "Links",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Heading",
            "default": "Quick links"
          },
          {
            "type": "link_list",
            "id": "menu",
            "label": "Menu",
            "info": "This menu won't show dropdown items",
            "default": "footer"
          }
        ]
      }
    ]
  }
{% endschema %}
