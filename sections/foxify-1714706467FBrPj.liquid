  "en": {
    "f-richtext-1714706461CnGFR-text_html": "affiliates",
    "f-heading-1714706461sn3Kc-text_html": "Affiliates Program",
    "f-richtext-1714706461VYIJe-text_html": "Welcome to The Future Rocks - we collaborate with a new generation of conscious jewellers, while celebrating the synergy of technology, emotions and scientific innovation. We are excited to partner with websites, blogs, and influencers from all over the world who share our passion for sustainable and future-forward jewelry.",
    "f-heading-1714706461tXSZp-text_html": "How to join our Affiliate Program?",
    "f-richtext-1714706461rVkTz-text_html": "We are committed to ensuring that our Affiliate Program is aligned with the values and standards of our brand. Therefore, we reserve the right to review and approve all applications to ensure that our brand is appropriately represented.",
    "f-richtext-17147064618SUv2-text_html": "If you have any questions about our Affiliate Program, please email us at <a href=\"mailto:media@thefuturerocks.com\">media@thefuturerocks.com</a> with your name, email address, website URL, or social media handle. We will review your application and respond within five business days with additional information on further actions.",
    "f-button-1714712768uID1h-button_label_html": "become our affiliate",
    "f-heading-1714713128qHnqR-text_html": "What are the benefits of joining our Affiliate Program?",
    "f-heading-1714713166vY6Qp-text_html": "What do you need to do as an affiliate?",
    "f-list-items-1714713981QlxGX-items-Item-1-title_html": "Free membership",
    "f-list-items-1714713981QlxGX-items-Item-6-title_html": "30-day cookie window",
    "f-list-items-1714713981QlxGX-items-Item-5-title_html": "Earn commission on global approved sales, excluding shipping, taxes, and returns",
    "f-list-items-1714713981QlxGX-items-Item-4-title_html": "Our affiliate network partner provides you with real-time reporting and sales tracking",
    "f-list-items-1714713981QlxGX-items-Item-3-title_html": "Personal support from our dedicated affiliate team",
    "f-list-items-1714713981QlxGX-items-Item-2-title_html": "Regular updates on new arrivals, exclusive collections, and the latest jewelry trends",
    "f-list-items-1714714161TbYXs-items-Item-1-title_html": "Having unlimited access to our pool of creative materials, you can enrich the content diversity of your blog posts effortlessly.",
    "f-list-items-1714714161TbYXs-items-Item-3-title_html": "Inspire your readers with The Future Rocks’ mission to envision a more honest future by supporting our long list of socially responsible jewelers. ",
    "f-list-items-1714714161TbYXs-items-Item-2-title_html": "Stay on top of limited drops and promotions and spread the word around."
  }
}
