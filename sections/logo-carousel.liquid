{%- comment -%}
  Logo carousel — 2026 redesign module.
  Bespoke replacement for the Foxify-built press-logo carousel, so the
  client can manage logos in the Customizer and styles aren't bound to
  the app. Pure CSS marquee: the logo set is rendered four times and
  the track animates one set-width per loop, so the scroll is seamless
  at any logo count. Only the first set carries links (duplicates are
  aria-hidden and link-free, keeping keyboard focus sane).
  All styling lives in assets/redesign.css (section 11).
{%- endcomment -%}

<div
  id="section-id-{{ section.id }}"
  class="logo-carousel"
  style="--lc-h: {{ section.settings.logo_height }}px; --lc-gap: {{ section.settings.logo_gap }}px; --lc-speed: {{ section.settings.speed }}s;"
  data-section-type="logo-carousel"
>
  {%- if section.settings.title != blank -%}
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="logo-carousel__viewport">
    <div class="logo-carousel__track">
      {%- for dup in (1..4) -%}
        <div class="logo-carousel__set"{% if dup > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- capture logo_img -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: height: 160 | image_tag: class: 'logo-carousel__img', loading: 'lazy', alt: block.settings.image.alt }}
              {%- else -%}
                <span class="logo-carousel__img logo-carousel__img--placeholder">Logo</span>
              {%- endif -%}
            {%- endcapture -%}

            {%- if dup == 1 and block.settings.link != blank -%}
              <a class="logo-carousel__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ logo_img }}</a>
            {%- elsif dup == 1 -%}
              <span class="logo-carousel__item" {{ block.shopify_attributes }}>{{ logo_img }}</span>
            {%- else -%}
              <span class="logo-carousel__item">{{ logo_img }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Logo carousel",
  "class": "section-logo-carousel",
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured in"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo height",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 20,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Space between logos",
      "default": 80
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scroll speed",
      "info": "Seconds per loop — higher is slower",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Transparent PNG/SVG recommended. Displayed at the section's logo height."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo carousel",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
