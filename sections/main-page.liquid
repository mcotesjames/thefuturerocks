{%- comment -%}
  Default page section. Renders the page title + admin rich-text
  content, plus optional redesign blocks (heading / secondary CTA).

  Two layouts:
  - Default: title and content in the container, blocks rendered
    after it on the 5% module grid. Pages with no blocks render
    exactly as they always have.
  - "Two-column header": title (grey heading-3) in the left column,
    content + blocks in the right — for pages like Jewelry Care.
    The heading block drops to heading-2 scale in this layout.
  Block styling lives in redesign.css (§23 heading, §31 split).
{%- endcomment -%}

{%- capture block_elements -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <div class="heading-module{% unless section.settings.split_header %} module-pad-inline{% endunless %}" {{ block.shopify_attributes }}>
          <h2 class="{% if section.settings.split_header %}heading-2{% else %}heading-1{% endif %} heading-module__title">{{ block.settings.heading | escape }}</h2>
        </div>
      {%- when 'link' -%}
        {%- if block.settings.url != blank -%}
          <div class="page-cta-block{% unless section.settings.split_header %} module-pad-inline{% endunless %}" {{ block.shopify_attributes }}>
            <a class="btn btn--secondary" href="{{ block.settings.url }}">
              <span class="btn__text">{{ block.settings.text | escape }}</span>
            </a>
          </div>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if section.settings.split_header -%}
  <div class="page-split module-pad-inline" data-cc-animate>
    <div class="page-header">
      <h1 class="majortitle">{{ page.title }}</h1>
    </div>
    <div class="page-split__content">
      {%- if page.content != blank -%}
        <div class="rte cf">{{ page.content }}</div>
      {%- endif -%}
      {{ block_elements }}
    </div>
  </div>
{%- else -%}
  <div class="container{% unless section.settings.full_width %} container--reading-width{% endunless %}" data-cc-animate>
    <div class="page-header">
      <h1 class="majortitle">{{ page.title }}</h1>
    </div>
    <div class="rte cf">
      {{ page.content }}
    </div>
  </div>
  {{ block_elements }}
{%- endif -%}

{% schema %}
  {
    "name": "Page",
    "class": "page-section-spacing",
    "settings": [
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Full width",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "split_header",
        "label": "Two-column header",
        "info": "Page title on the left; content and blocks on the right.",
        "default": false
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Heading"
          }
        ]
      },
      {
        "type": "link",
        "name": "Secondary CTA",
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "info": "The trailing + is added automatically.",
            "default": "Explore our jewelry"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Link"
          }
        ]
      }
    ]
  }
{% endschema %}
