    "f-richtext-171110151809VqQ-text_html": "<strong>K11 Musea<br /></strong><br />18 Salisbury Rd<br />Tsim Sha Tsui<br />Kowloon . Hong Kong",
    "f-heading-1711102878GQgrP-text_html": "the lab-grown store",
    "f-richtext-1711102878qScO6-text_html": "<p>Permanent Jewelry service is available upon reservation, free with a net purchase of HKD 5,000 or above for all customers.</p>",
    "f-countdown-1711102878m7EVj-day_label_html": "Days",
