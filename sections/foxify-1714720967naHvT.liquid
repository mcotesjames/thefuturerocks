    "f-collapsible-tab-1714725350AbAUU-heading_html": "Maximum referrals",
    "f-collapsible-tab-1714725350AbAUU-content_html": "Members have a maximum of 20 referral quotas per year.",
    "f-collapsible-tab-17147253519GR5g-heading_html": "Referee/referrer benefits",
