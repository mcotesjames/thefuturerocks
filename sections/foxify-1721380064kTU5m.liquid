  "en": {
    "f-richtext-172138005017Api-text_html": "visual identity standards",
    "f-heading-1721380050rf9mT-text_html": "brand guidelines",
    "f-richtext-1721380050xODwx-text_html": "This document contains the rules of the communication system. Follow these rules strictly to maintain brand consistency.",
