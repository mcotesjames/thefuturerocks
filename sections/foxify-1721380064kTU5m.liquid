    "f-richtext-1721380050ebvgE-text_html": "Extrude nor distort",
    "f-richtext-1721380050rWX0y-text_html": "Color gradient",
    "f-richtext-1721380050uvGvU-text_html": "Non-brand color as dominant",
    "f-richtext-1721380050McBsL-text_html": "conscience practices",
    "f-richtext-1721380050tHlr6-text_html": "Attach to foreign elements",
