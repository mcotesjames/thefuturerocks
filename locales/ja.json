    "foxify-1722482510WV1dG": {
      "f-heading-1722482545kF1a7-text_html": "ラストチャンス！",
      "f-richtext-1722482545UVdT2-text_html": "Design Lab の Zodiac コレクションの限定商品が最大 45％ オフ",
