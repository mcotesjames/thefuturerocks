  "sections": {
    "foxify-17096112925iF0r": {
      "f-heading-1709611258mBq0w-text_html": "is here",
      "f-richtext-1709611258EBsXm-text_html": "but...",
      "f-heading-1709611258yKt3I-text_html": "We don’t mean to disappoint, but we cannot ship Lightbox Jewelry products to Singapore, UAE, Macau, Iceland, Switzerland, Canada, and the US.",
      "f-button-1709611258q0w7c-button_label_html": "shop our collaboration"
    },
    "foxify-170986201903bu8": {
      "f-heading-1709861999FDwgi-text_html": "THE RING",
      "f-richtext-1709861999gVjFM-text_html": "Meticulously crafted. Science-powered.",
      "f-heading-1709861999rDOUc-text_html": "More amazing colors",
      "f-richtext-1709861999KaPo8-text_html": "THE RING band is crafted entirely from a single piece of lab-grown sapphire, made possible with advanced material science. Slip into another dimension where your lab-grown diamond levitates on your finger.",
      "f-heading-1709861999YVwni-text_html": "59 hours",
      "f-richtext-1709861999IVUfV-text_html": "Exemplified with innovative craftsmanship, precision cutting, faceting, and polishing for optimal light reflection.",
      "f-heading-1709861999DRa8G-text_html": "An essential collaboration.",
      "f-richtext-1709861999YUyde-text_html": "A testament to powerful collaboration, the two elegant ring center stone options are sourced exclusively from Lightbox. Featuring 2ct round-cut lab-grown diamonds in pink and blue variations, these diamonds showcase Lightbox’s renowned innovative science-powered approach.",
      "f-heading-1709861999uM1ve-text_html": "3 cuts",
      "f-richtext-1709861999HinHR-text_html": "Center stones certified by the International Gemological Institute and hand-picked by our in-house gemologist.",
      "f-collapsible-tab-1709942159NVl0O-heading_html": "International Gemological Institute",
      "f-collapsible-tab-1709942159NVl0O-content_html": "IGI is the world's largest gemological institute, operating 29 laboratory locations around the world grading finished jewelry, natural diamonds, lab-grown diamonds and gemstones.",
      "f-richtext-1709952128ZiaB2-text_html": "<p>the original</p>",
      "f-heading-1709952128GpZKQ-text_html": "THE RING I",
      "f-richtext-1709952128Ep4qb-text_html": "<p>Lab-grown diamond set in 18K white gold</p>",
      "f-button-17099521284FnFk-button_label_html": "order now",
      "f-richtext-1709952128WKYQu-text_html": "<p>New arrival</p>",
      "f-heading-1709952128Z1GNn-text_html": "THE RING II",
      "f-richtext-17099521283riqN-text_html": "<p>Lab-grown diamond set in 18K white gold</p>",
      "f-button-1709952128ILRGq-button_label_html": "order now",
      "f-richtext-1709952128abF2P-text_html": "<p>New arrival</p>",
      "f-heading-1709952128j2UDN-text_html": "THE RING II",
      "f-richtext-1709952128bpwD3-text_html": "<p>Lab-grown diamond set in 18K white gold</p>",
      "f-button-17099521284RSkf-button_label_html": "order now",
      "f-heading-1709958373phYg8-text_html": "Look",
      "f-heading-1709958820sPQJ4-text_html": "Oval cut",
      "f-richtext-1709958820T0OJj-text_html": "2 carat<br>F-color<br>VS1 lab-grown diamond<br>Set in 18K white gold",
      "f-heading-1709958820f9Zao-text_html": "Round cut",
      "f-richtext-1709958820vST4g-text_html": "2 carat<br>F-color<br>VS1 lab-grown diamond<br>Set in 18K white gold",
      "f-heading-1709958820GFfMW-text_html": "Princess cut",
      "f-richtext-17099588206o6yq-text_html": "2 carat<br>F-color<br>VS1 lab-grown diamond<br>Set in 18K white gold",
      "f-heading-1709975424WPsWx-text_html": "VS1 WHITE",
      "f-heading-17099755070Rc2v-text_html": "VS1 PINK",
      "f-heading-1709975526bKgHf-text_html": "VS1 BLUE",
      "f-heading-1709980336pg1jl-text_html": "Patent-pending gem, meticulously handcrafted into every band."
    },
    "foxify-1712289545znCoa": {
      "f-richtext-1712289727lCzUg-text_html": "<p>weekend special</p>",
      "f-heading-1712289727kYier-text_html": "permanent jewelry",
      "f-richtext-1712289727EWjmA-text_html": "<p>Permanent Jewelry service is available upon reservation, with chain options starting from HKD $400, or complimentary for offline customers with a net purchase of  HKD $5,000 or above.<br /><br />Speak to our staff for more information on the service.</p>",
      "f-button-1712289727h4NiT-button_label_html": "book Now",
      "f-richtext-1712290603J6wTm-text_html": "<a href=\"https://thefuturerocks.com/pages/the-future-rocks-k11-musea\">the lab-grown store</a>",
      "f-richtext-171229060393edS-text_html": "<a href=\"https://thefuturerocks.com/pages/the-future-rocks-k11-musea\">learn more</a>",
      "f-richtext-1712291602V69UM-text_html": "<p>weekend special</p>",
      "f-heading-17122916022n2MG-text_html": "permanent jewelry",
      "f-richtext-1712291602udjPr-text_html": "<p>Permanent Jewelry service is available upon reservation, with chain options starting from $400 HKD, or complimentary for offline customers with a net purchase of $5000 HKD or above.<br /><br />Speak to our staff for more information on the service.</p>",
      "f-button-17122916022jQjF-button_label_html": "book Now",
      "f-heading-1712293177fRZoF-text_html": "what is it?",
      "f-richtext-1712293181KEzgp-text_html": "Our Permanent jewelry is tailored to fit seamlessly, designed for continuous wear. We provide 14K solid gold chains in diverse styles suitable for everyday use. Personalize your jewelry with our extensive selection of charms and mix and match with our bracelets for a unique touch.",
      "f-heading-1712294143xgNb9-text_html": "what does it take?",
      "f-richtext-17122941713xO3u-text_html": "01",
      "f-heading-1712294171BVf4p-text_html": "select",
      "f-richtext-1712294179bQAmj-text_html": "Select a gold chain that speaks to your heart. Personalize your piece further by adding charms (optional).",
      "f-richtext-1712294630uGnPd-text_html": "02",
      "f-heading-1712294630PyXyi-text_html": "measure",
      "f-richtext-1712294630HaCd1-text_html": "We will measure your wrist to ensure a flawless, comfortable fit.",
      "f-richtext-1712294630Ble6O-text_html": "03",
      "f-heading-17122946300YGKI-text_html": "zap",
      "f-richtext-1712294630LDWOq-text_html": "Our trained welder will use a laser pen to securely seal the bracelet chains together, actual welding takes a few seconds, but please allow up to 15 minutes for the whole process.",
      "f-heading-1712295206lejOz-text_html": "chains",
      "f-richtext-1712295206ufWst-text_html": "Find a 14k Yellow Gold chain that matches you from the styles below",
      "f-heading-1712295244d3W3Q-text_html": "pendants",
      "f-richtext-1712295244PVKy3-text_html": "Add to your chain with our extensive selection of Lab-grown Diamond and Lab-grown Gemstone charms set in 14k Yellow Gold.<br /><br />\n<ul>\n<li>Lab-grown diamond charm -  HKD $1,600</li>\n<li>Lab-grown sapphire charm -  HKD $900 </li>\n</ul>",
      "f-heading-1712299140CZ2SP-text_html": "faq",
      "f-collapsible-tab-1712299140ZvGgE-heading_html": "What is permanent jewelry?",
      "f-collapsible-tab-1712299140ZvGgE-content_html": "Permanent jewelry refers to bracelets, necklaces, or other jewelry pieces without a traditional clasp. The ends are expertly soldered, and the jewelry is intended not to be removed regularly.",
      "f-collapsible-tab-17122991409LBvV-heading_html": "Can I wear permanent jewelry all day?",
      "f-collapsible-tab-17122991409LBvV-content_html": "Crafted from durable 14K gold, our permanent jewelry is hypoallergenic, water-resistant, and less prone to tarnishing compared to gold-plated jewelry.",
      "f-collapsible-tab-17122991405dg9E-heading_html": "Can I take off permanent jewelry?",
      "f-collapsible-tab-17122991405dg9E-content_html": "While permanent jewelry is designed to be worn forever, it can be removed if necessary. Carefully cut the welded jump ring with scissors to take it off. Please keep in mind that re-welding may be required to restore its original form.",
      "f-collapsible-tab-1712299309IwOXN-heading_html": "Does permanent jewelry hurt?",
      "f-collapsible-tab-1712299309IwOXN-content_html": "Rest assured, the welding process is completely painless. The heat involved only affects the jewelry and not your skin.",
      "f-collapsible-tab-17122993090OOet-heading_html": "How durable is permanent jewelry?",
      "f-collapsible-tab-17122993090OOet-content_html": "Our permanent jewelry is designed to stand the test of time. Crafted from durable 14K solid gold, it's an investment that will become a part of you, day and night.",
      "f-collapsible-tab-1712299309js4xa-heading_html": "What if my permanent jewelry is broken?",
      "f-collapsible-tab-1712299309js4xa-content_html": "If your permanent jewelry is broken and it falls within the two-year timeframe from the date of purchase, you can take advantage of our free complimentary rewelding service. Please reach out to the customer success team for further assistance.",
      "f-collapsible-tab-1712299362VJUki-heading_html": "Can I refund or exchange my permanent jewelry?",
      "f-collapsible-tab-1712299362VJUki-content_html": "Unfortunately, we are unable to provide refunds or exchanges for personalized jewelry items.",
      "f-collapsible-tab-1712299363AROwA-heading_html": "How to take care of my permanent bracelet?",
      "f-collapsible-tab-1712299363AROwA-content_html": "To maintain the beauty of your permanent bracelet, we recommend avoiding harsh chemicals and storing it in a soft pouch or box when not in use. Regular cleaning with a mild jewelry cleaner will help keep it looking its best.",
      "f-collapsible-tab-1712299363LDUMr-heading_html": "Should I get matching permanent jewelry with other people?",
      "f-collapsible-tab-1712299363LDUMr-content_html": "Permanent bracelets make an unforgettable gesture. Get matching forever bracelets with your best friend, or show your appreciation to your mom.",
      "f-heading-17123044134Bkup-text_html": "Kiosk LA111",
      "f-richtext-1712304413Nc53q-text_html": "<p>Opening Hours: 11am - 9pm Daily</p>",
      "f-button-1712304413M6jLs-button_label_html": "Get directions",
      "f-google-map-1712304413bPzgD-map_address_html": "K11 Musea, 18 Salisbury Rd, Tsim Sha Tsui, Hong Kong",
      "f-google-map-1712304413bPzgD-map_api_key_html": "AIzaSyD8jPBszjyZv23nQMfmgKx8Hjvw3rfp4FM",
      "f-richtext-17123045724qDN6-text_html": "<p><strong>K11 Musea<br /></strong><br />18 Salisbury Rd<br />Tsim Sha Tsui<br />Kowloon . Hong Kong</p>",
      "f-heading-1712305448EmVcj-text_html": "make a reservation",
      "f-richtext-17123054549BYQY-text_html": "We advise making an appointment, but walk-ins are possible. For optimal service, reserve one slot per person. One reservation only for each registered email account. Pre-booked appointments will be prioritized over walk-ins.",
      "f-button-17123054579s3J8-button_label_html": "book now",
      "f-richtext-1712305460ZK430-text_html": "Any changes or cancellations must be made at least 12 hours in advance. Arriving later than 10 or more minutes may result in rescheduling.",
      "f-heading-1723625738b7myR-text_html": "1",
      "f-heading-1723625963fyY74-text_html": "2",
      "f-heading-1723626002qBEQw-text_html": "3",
      "f-heading-1723626012MjIvx-text_html": "4",
      "f-heading-1723626022QVGh1-text_html": "5",
      "f-richtext-1723626099UvI4j-text_html": "<ol>\n<li>14K Yellow Gold 2.1 mm Paperclip Style Chain – HKD $ 1,500</li>\n<li>14K Yellow Gold 2.5 mm Cable Chain – HKD $1,500</li>\n<li>14K Yellow Gold 0.85 mm Faceted Beaded Cable Chain – HKD $1,000</li>\n<li>14K Yellow Gold 1.1 mm Rolo Chain – HKD $800</li>\n<li>14K Yellow Gold 1.3 mm Flat Cable Chain – HKD $400 or complimentary for offline customers with a net purchase of HKD $5,000 or above.</li>\n</ol>",
      "f-heading-1723626981dIUmj-text_html": "1",
      "f-heading-1723627006on4x6-text_html": "2",
      "f-heading-172362701983tUa-text_html": "3",
      "f-heading-1723627030SsIY2-text_html": "4",
      "f-heading-17236270438ZATq-text_html": "5"
